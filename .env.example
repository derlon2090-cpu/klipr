POSTGRES_DB=klipr
POSTGRES_USER=klipr
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://klipr:change-me@postgres:5432/klipr
REDIS_URL=redis://redis:6379/0
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=klipr-cloud
R2_REGION=auto
RECORDING_CHUNK_SECONDS=300
RECORDING_MAX_RECONNECTS=8
EGRESS_PROXY_URL=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
R2_PRESIGNED_URL_TTL_SECONDS=3600
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: https://klipr.cloud,https://klipr-zeta.vercel.app
KLIPR_CORS_ORIGINS=http://localhost:3000

# Authentication (set real values in Vercel; never commit them)
KLIPR_ACCESS_PASSWORD=
KLIPR_SESSION_SECRET=
KLIPR_ALLOWED_EMAIL=klipr.cloud@gmail.com
KLIPR_SECURE_COOKIES=false
KLIPR_STUDIO_URL=https://klipr.cloud
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://klipr.cloud/api/webhooks/twitch/eventsub
