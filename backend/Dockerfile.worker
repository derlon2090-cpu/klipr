FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements.worker.txt ./
RUN pip install -r requirements.worker.txt
COPY . .
RUN useradd --create-home --uid 10001 worker && mkdir -p /var/lib/klipr /tmp/klipr && chown -R worker:worker /app /var/lib/klipr /tmp/klipr
USER worker
ENV TMPDIR=/tmp/klipr
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD celery -A app.worker.celery_app inspect ping --timeout=5 || exit 1
CMD ["celery", "-A", "app.worker.celery_app", "worker", "--loglevel=INFO"]
